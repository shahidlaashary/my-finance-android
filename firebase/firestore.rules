rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every installation gets a Firebase Anonymous Auth UID. Users can
    // access only their own namespace; Meta credentials are never client data.
    match /installations/{installationUid} {
      allow read: if request.auth != null && request.auth.uid == installationUid;
      allow create, update, delete: if false;

      match /preferences/{documentId} {
        allow read: if request.auth != null && request.auth.uid == installationUid;
        allow write: if false;
      }

      match /whatsapp/{documentId} {
        allow read: if request.auth != null && request.auth.uid == installationUid;
        allow write: if false;
      }

      match /message_history/{messageId} {
        allow read: if request.auth != null && request.auth.uid == installationUid;
        allow write: if false;
      }
    }

    // Deny all unspecified client access by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
